; reserved word as label
mov: .data 1,2,3

; label too long
averyveryveryveryveryveryverylonglabel: .data 1

; missing args
DATA1: .data

; empty data
DATA2: .data

; invalid commas
DATA3: .data 1,,2
DATA4: .data ,3,4

; string issues
STR1: .string
STR2: .string hello
STR3: .string "unterminated
STR4: .string "ok" extra

; matrix errors
MAT1: .mat [0][2]
MAT2: .mat [2][0]
MAT3: .mat 2,2 1,2
MAT4: .mat [2][2] 1,2,3,4,5
MAT5: .mat [2][2] 1,,2
MAT6: .mat [2][2] a,b

; unknown directive
WHAT: .foobar 1,2

; bad opcodes
badop
add
sub 5
mov r1 r2
cmp r3,,r4
lea #5,r1
clr
jmp
not #5
red r1 r2

; bad directives again
.data "text"
.string 123
